# Only send build inputs. Local documents, reports, backups and tool state
# are excluded by default, including any new files at the repository root.
**
!package.json
!package-lock.json
!tsconfig.base.json
!Dockerfile
!.dockerignore
!compose.yaml
!compose.pilot.yaml
!apps/
!apps/**
!packages/
!packages/**
!scripts/
!scripts/**
!extensions/
!extensions/**

# Remove generated files again after allowing workspace source directories.
**/node_modules
**/.next
**/dist
**/build
**/out
**/coverage
**/.turbo
**/.cache
**/.vite
**/.vitest
**/.nyc_output
**/.npm
**/.pnpm-store
**/next-env.d.ts
**/*.tsbuildinfo
**/*.log
**/*.lcov
**/playwright-report
**/test-results

# Never copy secrets or credentials, including those nested in workspaces.
**/.env*
**/.npmrc
**/.netrc
**/.pgpass
**/.aws
**/.ssh
**/.certificates
**/*.pem
**/*.key
**/*.crt
**/*.cer
**/*.der
**/*.p12
**/*.pfx

# Runtime data and local databases are not image contents.
**/storage
**/backups
**/tmp
**/temp
**/artifacts
**/documentos-organizados
**/*.dump
**/*.backup
**/*.bak
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.doc
**/*.docx

# Nested repositories, local tools and temporary editor/Python files.
**/.git
**/.bob
**/.codex
**/.vercel
**/.railway
**/.idea
**/.history
**/__pycache__
**/.venv
**/venv
**/.pytest_cache
**/.ruff_cache
**/*.py[cod]
**/.DS_Store
**/._*
**/Thumbs.db
**/Desktop.ini
**/*.swp
**/*.swo
**/*~

# Explicit non-secret examples and the DOCX templates required by the API.
!.env.example
!.env.pilot.example
!apps/api/templates/*.docx
